display_name = "Runner Art Foundation + DAY Review Kit"
notes = "Runner DAY kit registered through ArtCatalog and exercised by the 360 m golden slice before normal DAY activation. Other biomes, shared character, seal and pickups retain procedural fallback until their authored milestones pass."
