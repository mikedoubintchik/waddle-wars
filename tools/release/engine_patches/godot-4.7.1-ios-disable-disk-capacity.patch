 uint64_t DirAccessUnix::get_space_left() {
+#if defined(IOS_ENABLED) && defined(WADDLE_IOS_DISK_CAPACITY_DISABLED)
+	// Preserve the virtual API/ABI without querying device capacity.
+	// Zero already represents an unavailable or failed capacity query upstream.
+	ERR_FAIL_V_MSG(0, "DirAccess.get_space_left() is unavailable in the Waddle Wars iOS template.");
+#else
 	struct statvfs vfs;
 	if (statvfs(current_dir.utf8().get_data(), &vfs) != 0) {
 		return 0;
 	}
 
 	return (uint64_t)vfs.f_bavail * (uint64_t)vfs.f_frsize;
+#endif
 }
 
